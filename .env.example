# ---------------------------------------------------------------------------
# Exemplo de configuracao. Copie para .env e ajuste.
# NENHUM segredo real deve ser commitado neste arquivo.
# ---------------------------------------------------------------------------

# --- Aplicacao -------------------------------------------------------------
APP_ENV=local
DEBUG=false
LOG_LEVEL=INFO
# JSON em producao, console colorido em desenvolvimento
LOG_FORMAT=console

# --- Banco de dados --------------------------------------------------------
# Padrao: SQLite (zero dependencia externa).
DATABASE_URL=sqlite+aiosqlite:///./dot_tutors.db
# PostgreSQL (requer `docker compose up -d db`):
# DATABASE_URL=postgresql+asyncpg://tutors:tutors@localhost:5432/tutors

# --- Autenticacao do admin -------------------------------------------------
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-esta-chave-em-qualquer-ambiente-real
JWT_ALGORITHM=HS256
ADMIN_ACCESS_TOKEN_TTL_MINUTES=30
EMBED_SESSION_TTL_MINUTES=30

# Usuario admin criado por `python -m scripts.seed`
SEED_ADMIN_EMAIL=admin@dot.local
SEED_ADMIN_PASSWORD=troque-esta-senha

# --- LLM -------------------------------------------------------------------
LLM_PROVIDER=google
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# Runner do agente: pydantic_ai (padrao) | langgraph (implementacao comparativa)
AGENT_RUNNER=pydantic_ai
AGENT_MAX_TOOL_CALLS=6
AGENT_TIMEOUT_SECONDS=45

# --- Conhecimento / fontes -------------------------------------------------
HISTORY_MAX_MESSAGES=20
SOURCE_MAX_BYTES=512000
SOURCE_CACHE_TTL_MINUTES=60
SOURCE_FETCH_TIMEOUT_SECONDS=10
# Permite buscar fontes em enderecos privados/loopback. Somente para testes locais.
SOURCE_ALLOW_PRIVATE_NETWORK=false

# --- CORS / embed ----------------------------------------------------------
ADMIN_ORIGIN=http://localhost:3000
# Origens liberadas por padrao ao criar uma embed key (separadas por virgula)
EMBED_DEFAULT_ORIGINS=http://localhost:3000

# --- Rate limit ------------------------------------------------------------
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_SESSION_PER_MINUTE=10

# --- Observabilidade (opcional) -------------------------------------------
# Vazio = desligado.
LOGFIRE_TOKEN=

# ---------------------------------------------------------------------------
# Configuracao de deploy (docker-compose.deploy.yml).
# Copie para .env.deploy e ajuste. NENHUM segredo real neste arquivo.
# ---------------------------------------------------------------------------

# --- URLs publicas ---------------------------------------------------------
# Como o navegador do visitante enxerga cada servico, ja com https.
# PUBLIC_API_URL entra no bundle do frontend em tempo de build: mudar exige rebuild.
PUBLIC_APP_URL=https://tutores.seu-dominio.com
PUBLIC_API_URL=https://api-tutores.seu-dominio.com

# --- Banco -----------------------------------------------------------------
POSTGRES_USER=tutors
POSTGRES_DB=tutors
# Gere com: openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Segredos da aplicacao -------------------------------------------------
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Use um dominio valido: dominios reservados (.local, .localhost) sao recusados no login.
SEED_ADMIN_EMAIL=admin@seu-dominio.com
SEED_ADMIN_PASSWORD=

# --- LLM -------------------------------------------------------------------
GEMINI_API_KEY=
LLM_MODEL=gemini-3.6-flash

# --- Rede ------------------------------------------------------------------
# Quantos proxies reversos existem na frente da API. 1 para um nginx/Traefik/Caddy.
# 0 desliga a leitura de X-Forwarded-For — correto apenas sem proxy nenhum.
TRUSTED_PROXY_HOPS=1

# Portas no loopback do host; o proxy reverso aponta para elas.
API_PORT=8000
WEB_PORT=3000

# --- Demonstracao ----------------------------------------------------------
# /docs e /openapi.json ficam desligados em producao por padrao. Ligue se quiser que
# alguem explore a API pelo navegador.
EXPOSE_API_DOCS=true

# Roda o seed a cada boot (idempotente): cria admin, tutores de demonstracao e uma chave
# de embed. Deixe true ate a entrevista; depois pode desligar.
RUN_SEED_ON_START=true

# Opcional: fixa a chave de embed usada por /demo. Sem isto, use /demo?key=SUA_CHAVE
# (o seed imprime o link pronto). Mudar exige rebuild do frontend.
DEMO_EMBED_KEY=

# Caminho do repositorio do frontend, relativo a este arquivo.
FRONTEND_CONTEXT=../dot-tutors-frontend
